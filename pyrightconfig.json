{
    "include": ["pyprocar/**/*.py", "tests/**/*.py"],
    "ignore": [
      "**/*.ipynb",
      "**/docs_hooks.py",
      "docs/",
      "sphinx/",
      "examples/",
      ".github/",
      "**/_version.py",
      "data/",
      "hack/"
